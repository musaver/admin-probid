# Database Configuration
DATABASE_URL="mysql://username:password@host:port/database_name"

# NextAuth.js Configuration
NEXTAUTH_SECRET="your-secret-key-here-use-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# In production (Vercel), NEXTAUTH_URL should be your actual domain:
# NEXTAUTH_URL="https://your-app-name.vercel.app"

# Optional: Database SSL (for production databases)
# DATABASE_SSL="true"

# --- Reverse sync: BidBridge -> OwnMidwest ---
# Credentials used to log in to OwnMidwest's API and push our changes to them.
OWNMIDWEST_API_BASE="https://data.ownmidwest.com/api"
OWNMIDWEST_EMAIL="lkw@easyboyweb.com"
OWNMIDWEST_PASSWORD="your-ownmidwest-password"
# Secret that protects the POST /api/sync/drain worker endpoint (cron / manual trigger).
SYNC_DRAIN_TOKEN="choose-a-long-random-string"